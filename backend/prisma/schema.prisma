  payable           Payable?                 @relation(fields: [payableId], references: [id], onDelete: Restrict)
  receivableId      String?                  @map("receivable_id") @db.Uuid
  receivable        Receivable?              @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  kind              FinancialAdjustmentKind
  calculationType   FinancialCalculationType @map("calculation_type")
  rate              Decimal?                 @db.Decimal(9, 6)
  baseAmount        Decimal                  @map("base_amount") @db.Decimal(14, 2)
  periodStart       DateTime?                @map("period_start") @db.Date
  periodEnd         DateTime?                @map("period_end") @db.Date
  calculatedAmount  Decimal                  @map("calculated_amount") @db.Decimal(14, 2)
  appliedAmount     Decimal                  @map("applied_amount") @db.Decimal(14, 2)
  reason            String
  calculationMemory Json                     @map("calculation_memory")
  createdById       String                   @map("created_by_id") @db.Uuid
  createdBy         User                     @relation("FinancialAdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reversedAt        DateTime?                @map("reversed_at")
  reversedById      String?                  @map("reversed_by_id") @db.Uuid
  reversedBy        User?                    @relation("FinancialAdjustmentReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  reversalReason    String?                  @map("reversal_reason")
  createdAt         DateTime                 @default(now()) @map("created_at")

  @@index([payableId, createdAt])
  @@index([receivableId, createdAt])
  @@index([kind, createdAt])
  @@map("financial_adjustments")
}

model FinancialRecurrence {
  id                   String                          @id @default(uuid()) @db.Uuid
  description          String
  type                 FinancialTitleType
  amount               Decimal                         @db.Decimal(14, 2)
  chartAccountId       String                          @map("chart_account_id") @db.Uuid
  chartAccount         ChartAccount                    @relation(fields: [chartAccountId], references: [id], onDelete: Restrict)
  costCenterId         String                          @map("cost_center_id") @db.Uuid
  costCenter           CostCenter                      @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  supplierId           String?                         @map("supplier_id") @db.Uuid
  supplier             Supplier?                       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  clientId             String?                         @map("client_id") @db.Uuid
  client               Client?                         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  counterpartyName     String?                         @map("counterparty_name")
  startDate            DateTime                        @map("start_date") @db.Date
  endDate              DateTime?                       @map("end_date") @db.Date
  frequency            FinancialRecurrenceFrequency
  dueDay               Int?                            @map("due_day")
  maxOccurrences       Int?                            @map("max_occurrences")
  generatedOccurrences Int                             @default(0) @map("generated_occurrences")
  status               FinancialRecurrenceStatus       @default(ACTIVE)
  nextOccurrence       DateTime                        @map("next_occurrence") @db.Date
  plannedMethod        PaymentMethod?                  @map("planned_method")
  plannedBankAccountId String?                         @map("planned_bank_account_id") @db.Uuid
  plannedBankAccount   BankAccount?                    @relation(fields: [plannedBankAccountId], references: [id], onDelete: Restrict)
  notes                String?
  createdById          String                          @map("created_by_id") @db.Uuid
  createdBy            User                            @relation("FinancialRecurrenceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  occurrences          FinancialRecurrenceOccurrence[]
  createdAt            DateTime                        @default(now()) @map("created_at")
  updatedAt            DateTime                        @updatedAt @map("updated_at")

  @@index([status, nextOccurrence])
  @@index([chartAccountId])
  @@index([costCenterId])
  @@map("financial_recurrences")
}

model FinancialRecurrenceOccurrence {
  id            String                              @id @default(uuid()) @db.Uuid
  recurrenceId  String                              @map("recurrence_id") @db.Uuid
  recurrence    FinancialRecurrence                 @relation(fields: [recurrenceId], references: [id], onDelete: Restrict)
  sequence      Int
  dueDate       DateTime                            @map("due_date") @db.Date
  status        FinancialRecurrenceOccurrenceStatus @default(PENDING)
  errorMessage  String?                             @map("error_message")
  generatedAt   DateTime?                           @map("generated_at")
  generatedById String?                             @map("generated_by_id") @db.Uuid
  generatedBy   User?                               @relation("RecurrenceOccurrenceGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  payable       Payable?                            @relation("OccurrencePayable")
  receivable    Receivable?                         @relation("OccurrenceReceivable")
  createdAt     DateTime                            @default(now()) @map("created_at")

  @@unique([recurrenceId, sequence])
  @@unique([recurrenceId, dueDate])
  @@index([status, dueDate])
  @@map("financial_recurrence_occurrences")
}

model BankAccount {
  id                 String                 @id @default(uuid()) @db.Uuid
  name               String
  institution        String?
  agency             String?
  accountNumber      String?                @map("account_number")
  type               BankAccountType
  holder             String?
  currency           String                 @default("BRL") @db.Char(3)
  initialBalance     Decimal                @default(0) @map("initial_balance") @db.Decimal(14, 2)
  initialBalanceDate DateTime               @map("initial_balance_date") @db.Date
  active             Boolean                @default(true)
  createdById        String                 @map("created_by_id") @db.Uuid
  createdBy          User                   @relation("BankAccountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  plannedPayables    Payable[]              @relation("PayablePlannedBankAccount")
  plannedReceivables Receivable[]           @relation("ReceivablePlannedBankAccount")
  payments           PayablePayment[]
  collections        ReceivableCollection[]
  recurrences        FinancialRecurrence[]
  movements          BankMovement[]
  statementImports   BankStatementImport[]
  transactions       BankTransaction[]
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  @@index([active, name])
  @@map("bank_accounts")
}

model BankMovement {
  id                     String                   @id @default(uuid()) @db.Uuid
  number                 String                   @unique
  bankAccountId          String                   @map("bank_account_id") @db.Uuid
  bankAccount            BankAccount              @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  nature                 BankMovementNature
  type                   BankMovementType
  amount                 Decimal                  @db.Decimal(14, 2)
  postedAt               DateTime                 @map("posted_at")
  description            String
  externalReference      String?                  @map("external_reference")
  transferGroupId        String?                  @map("transfer_group_id") @db.Uuid
  payablePaymentId       String?                  @unique @map("payable_payment_id") @db.Uuid
  payablePayment         PayablePayment?          @relation(fields: [payablePaymentId], references: [id], onDelete: Restrict)
  receivableCollectionId String?                  @unique @map("receivable_collection_id") @db.Uuid
  receivableCollection   ReceivableCollection?    @relation(fields: [receivableCollectionId], references: [id], onDelete: Restrict)
  createdById            String                   @map("created_by_id") @db.Uuid
  createdBy              User                     @relation("BankMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reversedAt             DateTime?                @map("reversed_at")
  reversedById           String?                  @map("reversed_by_id") @db.Uuid
  reversedBy             User?                    @relation("BankMovementReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  reversalReason         String?                  @map("reversal_reason")
  reconciliationLinks    BankReconciliationLink[]
  createdAt              DateTime                 @default(now()) @map("created_at")

  @@index([bankAccountId, postedAt])
  @@index([type, postedAt])
  @@index([transferGroupId])
  @@map("bank_movements")
}

model BankStatementImport {
  id            String                    @id @default(uuid()) @db.Uuid
  bankAccountId String                    @map("bank_account_id") @db.Uuid
  bankAccount   BankAccount               @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  fileName      String                    @map("file_name")
  contentType   String                    @map("content_type")
  size          Int
  sha256        String
  content       Bytes
  format        String                    @db.VarChar(8)
  status        BankStatementImportStatus @default(PREVIEWED)
  periodStart   DateTime?                 @map("period_start") @db.Date
  periodEnd     DateTime?                 @map("period_end") @db.Date
  preview       Json
  totalRows     Int                       @map("total_rows")
  importedRows  Int                       @default(0) @map("imported_rows")
  duplicateRows Int                       @default(0) @map("duplicate_rows")
  errorMessage  String?                   @map("error_message")
  createdById   String                    @map("created_by_id") @db.Uuid
  createdBy     User                      @relation("BankStatementImportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  transactions  BankTransaction[]
  createdAt     DateTime                  @default(now()) @map("created_at")
  completedAt   DateTime?                 @map("completed_at")

  @@unique([bankAccountId, sha256])
  @@index([bankAccountId, createdAt])
  @@map("bank_statement_imports")
}

model BankTransaction {
  id                   String                              @id @default(uuid()) @db.Uuid
  bankAccountId        String                              @map("bank_account_id") @db.Uuid
  bankAccount          BankAccount                         @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  statementImportId    String                              @map("statement_import_id") @db.Uuid
  statementImport      BankStatementImport                 @relation(fields: [statementImportId], references: [id], onDelete: Restrict)
  transactionDate      DateTime                            @map("transaction_date") @db.Date
  processedAt          DateTime?                           @map("processed_at")
  description          String
  bankIdentifier       String?                             @map("bank_identifier")
  amount               Decimal                             @db.Decimal(14, 2)
  nature               BankMovementNature
  reference            String?
  fingerprint          String                              @unique
  reconciliationStatus BankTransactionReconciliationStatus @default(PENDING) @map("reconciliation_status")
  ignoredReason        String?                             @map("ignored_reason")
  reconciliationLinks  BankReconciliationLink[]
  createdAt            DateTime                            @default(now()) @map("created_at")

  @@index([bankAccountId, transactionDate])
  @@index([reconciliationStatus, transactionDate])
  @@map("bank_transactions")
}

model BankReconciliation {
  id             String                   @id @default(uuid()) @db.Uuid
  notes          String?
  createdById    String                   @map("created_by_id") @db.Uuid
  createdBy      User                     @relation("BankReconciliationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reversedAt     DateTime?                @map("reversed_at")
  reversedById   String?                  @map("reversed_by_id") @db.Uuid
  reversedBy     User?                    @relation("BankReconciliationReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  reversalReason String?                  @map("reversal_reason")
  links          BankReconciliationLink[]
  createdAt      DateTime                 @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("bank_reconciliations")
}

model BankReconciliationLink {
  id                String             @id @default(uuid()) @db.Uuid
  reconciliationId  String             @map("reconciliation_id") @db.Uuid
  reconciliation    BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  bankTransactionId String             @map("bank_transaction_id") @db.Uuid
  bankTransaction   BankTransaction    @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  bankMovementId    String             @map("bank_movement_id") @db.Uuid
  bankMovement      BankMovement       @relation(fields: [bankMovementId], references: [id], onDelete: Restrict)
  amount            Decimal            @db.Decimal(14, 2)
  createdAt         DateTime           @default(now()) @map("created_at")

  @@unique([reconciliationId, bankTransactionId, bankMovementId])
  @@index([bankTransactionId])
  @@index([bankMovementId])
  @@map("bank_reconciliation_links")
}

model FinancialAttachment {
  id           String      @id @default(uuid()) @db.Uuid
  payableId    String?     @map("payable_id") @db.Uuid
  payable      Payable?    @relation(fields: [payableId], references: [id], onDelete: Restrict)
  receivableId String?     @map("receivable_id") @db.Uuid
  receivable   Receivable? @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  fileName     String      @map("file_name")
  contentType  String      @map("content_type")
  size         Int
  sha256       String
  content      Bytes
  active       Boolean     @default(true)
  uploadedById String      @map("uploaded_by_id") @db.Uuid
  uploadedBy   User        @relation("FinancialAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  removedAt    DateTime?   @map("removed_at")
  removedById  String?     @map("removed_by_id") @db.Uuid
  removedBy    User?       @relation("FinancialAttachmentRemovedBy", fields: [removedById], references: [id], onDelete: Restrict)
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([payableId, active])
  @@index([receivableId, active])
  @@index([sha256])
  @@map("financial_attachments")
}

model FinancialForecastSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  snapshotDate DateTime @map("snapshot_date") @db.Date
  periodStart  DateTime @map("period_start") @db.Date
  periodEnd    DateTime @map("period_end") @db.Date
  filters      Json?
  data         Json
  createdById  String   @map("created_by_id") @db.Uuid
  createdBy    User     @relation("FinancialSnapshotCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([snapshotDate, periodStart, periodEnd])
  @@map("financial_forecast_snapshots")
}
