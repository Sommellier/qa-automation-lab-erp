model User {
  id                             String                          @id @default(uuid()) @db.Uuid
  name                           String
  email                          String                          @unique
  passwordHash                   String                          @map("password_hash")
  role                           UserRole
  active                         Boolean                         @default(true)
  tokenVersion                   Int                             @default(0) @map("token_version")
  createdAt                      DateTime                        @default(now()) @map("created_at")
  updatedAt                      DateTime                        @updatedAt @map("updated_at")
  auditLogs                      AuditLog[]
  importJobs                     ImportJob[]
  stockMovements                 StockMovement[]
  passwordResetTokens            PasswordResetToken[]
  createdPurchaseOrders          PurchaseOrder[]
  purchaseReceipts               PurchaseReceipt[]
  payablePaymentsCreated         PayablePayment[]                @relation("PaymentCreatedBy")
  payablePaymentsReversed        PayablePayment[]                @relation("PaymentReversedBy")
  receivableCollectionsCreated   ReceivableCollection[]          @relation("CollectionCreatedBy")
  receivableCollectionsReversed  ReceivableCollection[]          @relation("CollectionReversedBy")
  approvedPurchaseOrders         PurchaseOrder[]                 @relation("PurchaseApprovedBy")
  purchaseApprovalEvents         PurchaseApprovalEvent[]
  updatedPurchaseApprovalRules   PurchaseApprovalRule[]          @relation("ApprovalRuleUpdatedBy")
  updatedFiscalCompanies         FiscalCompany[]                 @relation("FiscalCompanyUpdatedBy")
  fiscalImportBatches            FiscalImportBatch[]
  createdFiscalDocuments         FiscalDocument[]                @relation("FiscalDocumentCreatedBy")
  uploadedFiscalAttachments      FiscalAttachment[]              @relation("FiscalAttachmentUploadedBy")
  removedFiscalAttachments       FiscalAttachment[]              @relation("FiscalAttachmentRemovedBy")
  fiscalPayableLinks             FiscalPayableLink[]
  fiscalReceivableLinks          FiscalReceivableLink[]
  createdReturns                 ReturnProcess[]                 @relation("ReturnCreatedBy")
  approvedReturns                ReturnProcess[]                 @relation("ReturnApprovedBy")
  returnHistories                ReturnHistory[]                 @relation("ReturnHistoryActor")
  inspectedReturnItems           ReturnItem[]                    @relation("ReturnItemInspectedBy")
  createdReturnAdjustments       ReturnFinancialAdjustment[]     @relation("ReturnAdjustmentCreatedBy")
  approvedReturnAdjustments      ReturnFinancialAdjustment[]     @relation("ReturnAdjustmentApprovedBy")
  settledReturnAdjustments       ReturnFinancialAdjustment[]     @relation("ReturnAdjustmentSettledBy")
  returnFiscalLinks              ReturnFiscalLink[]
  uploadedReturnAttachments      ReturnAttachment[]              @relation("ReturnAttachmentUploadedBy")
  removedReturnAttachments       ReturnAttachment[]              @relation("ReturnAttachmentRemovedBy")
  createdPayables                Payable[]                       @relation("PayableCreatedBy")
  createdReceivables             Receivable[]                    @relation("ReceivableCreatedBy")
  createdCostCenters             CostCenter[]                    @relation("CostCenterCreatedBy")
  createdChartAccounts           ChartAccount[]                  @relation("ChartAccountCreatedBy")
  createdFinancialAdjustments    FinancialAdjustment[]           @relation("FinancialAdjustmentCreatedBy")
  reversedFinancialAdjustments   FinancialAdjustment[]           @relation("FinancialAdjustmentReversedBy")
  createdFinancialRecurrences    FinancialRecurrence[]           @relation("FinancialRecurrenceCreatedBy")
  generatedRecurrenceOccurrences FinancialRecurrenceOccurrence[] @relation("RecurrenceOccurrenceGeneratedBy")
  createdBankAccounts            BankAccount[]                   @relation("BankAccountCreatedBy")
  createdBankMovements           BankMovement[]                  @relation("BankMovementCreatedBy")
  reversedBankMovements          BankMovement[]                  @relation("BankMovementReversedBy")
  bankStatementImports           BankStatementImport[]           @relation("BankStatementImportCreatedBy")
  bankReconciliations            BankReconciliation[]            @relation("BankReconciliationCreatedBy")
  reversedBankReconciliations    BankReconciliation[]            @relation("BankReconciliationReversedBy")
  uploadedFinancialAttachments   FinancialAttachment[]           @relation("FinancialAttachmentUploadedBy")
  removedFinancialAttachments    FinancialAttachment[]           @relation("FinancialAttachmentRemovedBy")
  financialSnapshots             FinancialForecastSnapshot[]     @relation("FinancialSnapshotCreatedBy")
  responsibleWarehouses          Warehouse[]                     @relation("WarehouseResponsible")
  createdWarehouses              Warehouse[]                     @relation("WarehouseCreatedBy")
  createdStockTransfers          StockTransfer[]                 @relation("StockTransferCreatedBy")
  approvedStockTransfers         StockTransfer[]                 @relation("StockTransferApprovedBy")
  shippedStockTransfers          StockTransfer[]                 @relation("StockTransferShippedBy")
  receivedStockTransfers         StockTransfer[]                 @relation("StockTransferReceivedBy")
  createdStockInventories        StockInventory[]                @relation("StockInventoryCreatedBy")
  approvedStockInventories       StockInventory[]                @relation("StockInventoryApprovedBy")
  stockInventoryCounts           StockInventoryCount[]           @relation("StockInventoryCountedBy")
  createdStockAdjustments        StockAdjustment[]               @relation("StockAdjustmentCreatedBy")
  approvedStockAdjustments       StockAdjustment[]               @relation("StockAdjustmentApprovedBy")
  appliedStockAdjustments        StockAdjustment[]               @relation("StockAdjustmentAppliedBy")
  stockCostEvents                StockCostHistory[]              @relation("StockCostCreatedBy")
  orderShipments                 OrderShipment[]                 @relation("OrderShipmentCreatedBy")
  cogsEntries                    CogsEntry[]                     @relation("CogsCreatedBy")
  createdQuotes                  Quote[]                         @relation("QuoteCreatedBy")
  soldQuotes                     Quote[]                         @relation("QuoteSeller")
  approvedQuotes                 Quote[]                         @relation("QuoteApprovedBy")
  quoteNegotiations              QuoteNegotiation[]
  updatedQuoteApprovalRules      QuoteApprovalRule[]             @relation("QuoteApprovalRuleUpdatedBy")
  commissionRule                 SalesCommissionRule?            @relation("SalesCommissionUser")
  updatedCommissionRules         SalesCommissionRule[]           @relation("SalesCommissionRuleUpdatedBy")
  soldOrders                     Order[]                         @relation("OrderSeller")

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model SecurityThrottle {
  id              String    @id @default(uuid()) @db.Uuid
  scope           String    @db.VarChar(64)
  subjectHash     String    @map("subject_hash") @db.Char(64)
  attemptCount    Int       @default(0) @map("attempt_count")
  blockLevel      Int       @default(0) @map("block_level")
  windowStartedAt DateTime  @map("window_started_at")
  blockedUntil    DateTime? @map("blocked_until")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([scope, subjectHash])
  @@index([blockedUntil])
  @@index([updatedAt])
  @@map("security_throttles")
}

model ImportJob {
  id           String       @id @default(uuid()) @db.Uuid
  type         ImportType
  fileName     String       @map("file_name")
  totalRows    Int          @map("total_rows")
  validRows    Int          @map("valid_rows")
  invalidRows  Int          @map("invalid_rows")
  importedRows Int          @default(0) @map("imported_rows")
  status       ImportStatus
  errors       Json?
  createdById  String       @map("created_by_id") @db.Uuid
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime     @default(now()) @map("created_at")
  completedAt  DateTime?    @map("completed_at")

  @@index([createdAt])
  @@index([createdById, createdAt])
  @@index([type, status, createdAt])
  @@map("import_jobs")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  entityType AuditEntity @map("entity_type")
  entityId   String      @map("entity_id")
  action     AuditAction
  oldData    Json?       @map("old_data")
  newData    Json?       @map("new_data")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([entityType, createdAt])
  @@index([entityId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Client {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String
  document             String                @unique
  email                String                @unique
  phone                String?
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  orders               Order[]
  addresses            ClientAddress[]
  receivables          Receivable[]          @relation("ReceivableClient")
  fiscalDocuments      FiscalDocument[]
  returns              ReturnProcess[]
  financialRecurrences FinancialRecurrence[]
  quotes               Quote[]

  @@index([active])
  @@index([createdAt])
  @@map("clients")
}

model ClientAddress {
  id         String      @id @default(uuid()) @db.Uuid
  clientId   String      @map("client_id") @db.Uuid
  client     Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  type       AddressType
  zipCode    String      @map("zip_code")
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  country    String
  isPrimary  Boolean     @default(false) @map("is_primary")
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@index([clientId])
  @@index([clientId, active])
  @@index([clientId, isPrimary])
  @@index([createdAt])
  @@map("client_addresses")
}

model Product {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String
  sku                  String                @unique
  description          String?
  price                Decimal               @db.Decimal(12, 2)
  stock                Int
  trackingMode         ProductTrackingMode   @default(NONE) @map("tracking_mode")
  expiryWarningDays    Int                   @default(30) @map("expiry_warning_days")
  blockExpired         Boolean               @default(true) @map("block_expired")
  averageCost          Decimal               @default(0) @map("average_cost") @db.Decimal(14, 6)
  stockValue           Decimal               @default(0) @map("stock_value") @db.Decimal(16, 2)
  categoryId           String                @map("category_id") @db.Uuid
  category             Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  orderItems           OrderItem[]
  stockMovements       StockMovement[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseReceiptItems PurchaseReceiptItem[]
  fiscalDocumentItems  FiscalDocumentItem[]
  returnItems          ReturnItem[]          @relation("ReturnItemProduct")
  replacementItems     ReturnItem[]          @relation("ReturnItemReplacementProduct")
  inventoryBalances    InventoryBalance[]
  stockLots            StockLot[]
  stockSerials         StockSerial[]
  stockReservations    StockReservation[]
  transferItems        StockTransferItem[]
  inventoryItems       StockInventoryItem[]
  adjustmentItems      StockAdjustmentItem[]
  costHistory          StockCostHistory[]
  shipmentItems        OrderShipmentItem[]
  cogsEntries          CogsEntry[]
  quoteItems           QuoteItem[]
  quoteReservations    QuoteReservation[]

  @@index([active, stock])
  @@index([categoryId])
  @@index([createdAt])
  @@map("products")
}

model Quote {
  id                  String             @id @default(uuid()) @db.Uuid
  number              String             @unique
  status              QuoteStatus        @default(DRAFT)
  clientId            String             @map("client_id") @db.Uuid
  client              Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sellerId            String             @map("seller_id") @db.Uuid
  seller              User               @relation("QuoteSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  createdById         String             @map("created_by_id") @db.Uuid
  createdBy           User               @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById        String?            @map("approved_by_id") @db.Uuid
  approvedBy          User?              @relation("QuoteApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt          DateTime?          @map("approved_at")
  rejectionReason     String?            @map("rejection_reason")
  grossTotal          Decimal            @map("gross_total") @db.Decimal(14, 2)
  discountTotal       Decimal            @default(0) @map("discount_total") @db.Decimal(14, 2)
  discountPercent     Decimal            @default(0) @map("discount_percent") @db.Decimal(7, 4)
  total               Decimal            @db.Decimal(14, 2)
  commissionRate      Decimal            @default(0) @map("commission_rate") @db.Decimal(7, 4)
  commissionAmount    Decimal            @default(0) @map("commission_amount") @db.Decimal(14, 2)
  paymentInstallments Int                @default(1) @map("payment_installments")
  firstPaymentDueDays Int                @default(30) @map("first_payment_due_days")
  paymentIntervalDays Int                @default(30) @map("payment_interval_days")
  validUntil          DateTime           @map("valid_until") @db.Date
  reservationHours    Int                @default(24) @map("reservation_hours")
  notes               String?
  items               QuoteItem[]
  negotiations        QuoteNegotiation[]
  reservations        QuoteReservation[]
  order               Order?
  stockMovements      StockMovement[]
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@index([status, validUntil])
  @@index([clientId, createdAt])
  @@index([sellerId, createdAt])
  @@index([createdAt])
  @@map("quotes")
}

model QuoteItem {
  id                String             @id @default(uuid()) @db.Uuid
  quoteId           String             @map("quote_id") @db.Uuid
  quote             Quote              @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  productId         String             @map("product_id") @db.Uuid
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName       String             @map("product_name")
  productSku        String             @map("product_sku")
  quantity          Int
  originalUnitPrice Decimal            @map("original_unit_price") @db.Decimal(12, 2)
  discountPercent   Decimal            @default(0) @map("discount_percent") @db.Decimal(7, 4)
  unitPrice         Decimal            @map("unit_price") @db.Decimal(12, 2)
  subtotal          Decimal            @db.Decimal(14, 2)
  reservations      QuoteReservation[]
  stockMovements    StockMovement[]

  @@unique([quoteId, productId])
  @@index([productId])
  @@map("quote_items")
}

model QuoteNegotiation {
  id        String                 @id @default(uuid()) @db.Uuid
  quoteId   String                 @map("quote_id") @db.Uuid
  quote     Quote                  @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  action    QuoteNegotiationAction
  comment   String?
  metadata  Json?
  actorId   String                 @map("actor_id") @db.Uuid
  actor     User                   @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorRole UserRole               @map("actor_role")
  createdAt DateTime               @default(now()) @map("created_at")

  @@index([quoteId, createdAt])
