generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ANALISTA
  VISUALIZADOR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

enum QuoteNegotiationAction {
  CREATE
  UPDATE
  NOTE
  SUBMIT
  APPROVE
  REJECT
  RESERVE
  RELEASE
  RENEW
  CONVERT
  CANCEL
  EXPIRE
}

enum AddressType {
  RESIDENTIAL
  COMMERCIAL
  BILLING
  OTHER
}

enum AuditEntity {
