  FINANCIAL_RECURRENCE
  BANK_ACCOUNT
  BANK_STATEMENT_IMPORT
  BANK_RECONCILIATION
  FINANCIAL_SNAPSHOT
  WAREHOUSE
  STOCK_TRANSFER
  STOCK_INVENTORY
  STOCK_ADJUSTMENT
  STOCK_COST
  COGS
  QUOTE
