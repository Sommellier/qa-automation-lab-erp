NODE_ENV=development
PORT=3333
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/qa_management?schema=public"
JWT_SECRET="substitua-por-um-segredo-com-32-caracteres-ou-mais"
# Sessão curta: acesso renovável por até 8 horas, sem estado no servidor.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=8
FRONTEND_URL="http://localhost:5173"
PASSWORD_RESET_TTL_MINUTES=15
# console só envia o link para a saída local quando NODE_ENV=development.
PASSWORD_RESET_MAIL_MODE=console
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_BASE_BLOCK_MINUTES=1
RATE_LIMIT_MAX_BLOCK_MINUTES=30
RATE_LIMIT_ESCALATION_RESET_MINUTES=1440
# Exclusivo da suíte E2E local. A aplicação rejeita este valor fora de NODE_ENV=test.
DISABLE_LOGIN_RATE_LIMIT=false
# Ajuste somente quando houver um proxy reverso confiável na frente da API.
TRUST_PROXY_HOPS=0
CSV_IMPORT_MAX_FILE_SIZE_MB=5
CSV_IMPORT_MAX_ROWS=5000
# Importação fiscal síncrona em memória; mantenha limites compatíveis com a infraestrutura.
FISCAL_XML_MAX_FILE_SIZE_MB=5
FISCAL_XML_MAX_FILES=20
FISCAL_ATTACHMENT_MAX_FILE_SIZE_MB=10
RETURN_ATTACHMENT_MAX_FILE_SIZE_MB=10
FINANCIAL_ATTACHMENT_MAX_FILE_SIZE_MB=10
BANK_STATEMENT_MAX_FILE_SIZE_MB=5
BANK_STATEMENT_MAX_ROWS=10000
