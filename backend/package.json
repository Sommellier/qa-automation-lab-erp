{
  "name": "@qa-management/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "concurrently -n build,server -c yellow,blue \"tsc -p tsconfig.json --watch\" \"node --watch dist/src/server.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:validate-stock": "node scripts/validate-advanced-stock.mjs",
    "db:seed": "tsc -p tsconfig.json && prisma db seed"
  },
  "prisma": {
    "seed": "node dist/prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcrypt": "6.0.0",
    "cors": "2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "fast-xml-parser": "^5.7.3",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "^2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "24.5.2",
    "prisma": "6.12.0",
    "typescript": "5.9.2",
    "vitest": "5.0.5"
  }
}
